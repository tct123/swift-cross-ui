{"abstract":[{"text":"A view the displays text.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/View","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ViewBuilder","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/VStack","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/HorizontalAlignment","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/HStack","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/VerticalAlignment","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ZStack","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Image","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Color","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Divider","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Spacer","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ForEach","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Group","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollView","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Axis"],"generated":true}],"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SwiftCrossUI\/s8CopyableP","doc:\/\/SwiftCrossUI\/s8SendableP","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/View"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/swiftcrossui\/text"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/stackotter\/swift-cross-ui\/blob\/main\/Sources\/SwiftCrossUI\/Views\/Text.swift#L46","fileName":"Text.swift"},"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Text"}],"navigatorTitle":[{"text":"Text","kind":"identifier"}],"role":"symbol","externalID":"s:12SwiftCrossUI4TextV","modules":[{"name":"SwiftCrossUI"}],"title":"Text","roleHeading":"Structure"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text\/init(_:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text\/asWidget(backend:)","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text\/commit(_:layout:environment:backend:)","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text\/computeLayout(_:proposedSize:environment:backend:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text\/View-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Text"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text","type":"reference","isActive":true},{"type":"text","text":" truncates its content to fit within its proposed size. To wrap"},{"type":"text","text":" "},{"type":"text","text":"without truncation, put the "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text","type":"reference","isActive":true},{"type":"text","text":" (or its enclosing view hierarchy) into"},{"type":"text","text":" "},{"type":"text","text":"an ideal height context such as a "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollView","type":"reference","isActive":true},{"type":"text","text":". Alternatively, use"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/View\/fixedSize(horizontal:vertical:)","type":"reference","isActive":true},{"type":"text","text":" with "},{"type":"codeVoice","code":"horizontal"},{"type":"text","text":" set to false and"},{"type":"text","text":" "},{"type":"codeVoice","code":"vertical"},{"type":"text","text":" set to true, but be aware that this may lead to unintuitive"},{"type":"text","text":" "},{"type":"text","text":"minimum sizing behaviour when used within a window. Often when developers"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"fixedSize"},{"type":"text","text":" on text, what they really need is a "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollView","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"To avoid wrapping and truncation entirely, use ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/View\/fixedSize()","type":"reference","isActive":true},{"text":".","type":"text"}]},{"text":"Technical notes","type":"heading","anchor":"Technical-notes","level":2},{"type":"paragraph","inlineContent":[{"text":"The reason that ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Text","type":"reference"},{"text":" truncates its content to fit its proposed size is","type":"text"},{"text":" ","type":"text"},{"text":"that SwiftCrossUI’s layout system behaves rather unintuitively with views that","type":"text"},{"text":" ","type":"text"},{"text":"trade off width for height. The layout system used to support this behaviour","type":"text"},{"text":" ","type":"text"},{"text":"well, but when overhauling the layout system with performance in mind, we","type":"text"},{"text":" ","type":"text"},{"text":"discovered that it’s not possible to handle minimum view sizing in the","type":"text"},{"text":" ","type":"text"},{"text":"intuitive way that we were, without a large performance cost or layout system","type":"text"},{"text":" ","type":"text"},{"text":"complexity cost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"With the current system, windows determine the minimum size of their content","type":"text"},{"text":" ","type":"text"},{"text":"by proposing a size of 0x0. A text view that doesn’t truncate its content","type":"text"},{"text":" ","type":"text"},{"text":"would take on a width of 0 and then lay out each character on a new line (as","type":"text"},{"text":" ","type":"text"},{"text":"that’s what most UI frameworks do when text is given a small width). This leads","type":"text"},{"text":" ","type":"text"},{"text":"to the window thinking that its minimum height is ","type":"text"},{"code":"characterCount * lineHeight","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"even though when given a width larger than zero, the text view would be shorter","type":"text"},{"text":" ","type":"text"},{"text":"than this ‘minimum height’. The underlying cause is the assumption that","type":"text"},{"text":" ","type":"text"},{"text":"‘minimum size’ is a sensible notion for every view. A text view without","type":"text"},{"text":" ","type":"text"},{"text":"truncation doesn’t have a ‘minimum size’; are we minimizing width? minimizing","type":"text"},{"text":" ","type":"text"},{"text":"height? minimizing width + height? minimizing area?","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftCrossUI’s old layout system separated the concept of minimum size into"},{"type":"text","text":" "},{"type":"text","text":"‘minimum width for current height’, and ‘minimum height for current width’."},{"type":"text","text":" "},{"type":"text","text":"This led to much more intuitive window sizing behaviour. If you had"},{"type":"text","text":" "},{"type":"text","text":"non-truncating text inside a window, and resized the width of the window"},{"type":"text","text":" "},{"type":"text","text":"such that the height of the text became taller than the window, then the window"},{"type":"text","text":" "},{"type":"text","text":"would become taller, and if you resized the height of the window then you’d reach"},{"type":"text","text":" "},{"type":"text","text":"the window’s minimum height before the text could overflow the window horizontally."},{"type":"text","text":" "},{"type":"text","text":"Unfortunately this required a lot of book-keeping, and was deemed to be unfeasible"},{"type":"text","text":" "},{"type":"text","text":"to do without significantly hurting performance due to all the layout assumptions"},{"type":"text","text":" "},{"type":"text","text":"that we’d have to drop from our stack layout algorithm."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The new layout system behaviour is in-line with SwiftUI’s layout behaviour."}]}]}],"references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI/Spacer":{"url":"\/documentation\/swiftcrossui\/spacer","abstract":[{"text":"A flexible space that expands along the major axis of its containing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stack layout, or on both axes if not contained in a stack."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Spacer"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Spacer","title":"Spacer","navigatorTitle":[{"kind":"identifier","text":"Spacer"}]},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Divider":{"abstract":[{"text":"A divider that expands along the minor axis of the containing stack layout","type":"text"},{"text":" ","type":"text"},{"text":"(or horizontally otherwise). In dark mode it’s white with 10% opacity, and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in light mode it’s black with 10% opacity."}],"kind":"symbol","type":"topic","url":"\/documentation\/swiftcrossui\/divider","fragments":[{"kind"