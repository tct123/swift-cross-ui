{"metadata":{"modules":[{"name":"SwiftCrossUI"}],"title":"DefaultBackend","roleHeading":"Article","role":"article"},"sections":[],"abstract":[{"text":"An adaptive backend which uses different backends under the hood depending on the target operating system.","type":"text"}],"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend"]}],"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcrossui\/defaultbackend"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The beauty of SwiftCrossUI is that you can write your app once and have it look native everywhere. For this reason I recommend using DefaultBackend unless you’ve got particular constraints. It uses ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","isActive":true,"type":"reference"},{"text":" on macOS, ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","isActive":true,"type":"reference"},{"text":" on Window, ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","isActive":true,"type":"reference"},{"text":" on Linux, and on ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","isActive":true,"type":"reference"},{"text":" on iOS\/tvOS.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re using DefaultBackend, you can override the underlying backend during compilation by setting the "},{"code":"SCUI_DEFAULT_BACKEND","type":"codeVoice"},{"type":"text","text":" environment variable to the name of the desired backend. This is useful when you e.g. want to test the Gtk version of your app while using a Mac. Note that this only works for built-in backends and still requires the chosen backend to be compatible with your machine."}]}],"name":"Tip","style":"tip","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When using "},{"type":"codeVoice","code":"SCUI_DEFAULT_BACKEND"},{"type":"text","text":" to switch underlying backends, you may encounter some linker-related missing symbol errors. These are caused by a SwiftPM bug and usually disappear if you run "},{"type":"codeVoice","code":"swift package clean"},{"type":"text","text":" before attempting to build your app again."}]}],"name":"Warning","style":"warning","type":"aside"},{"anchor":"Usage","level":2,"text":"Usage","type":"heading"},{"syntax":"swift","code":["...","","let package = Package(","  ...","  targets: [","    ...","    .executableTarget(","      name: \"YourApp\",","      dependencies: [","        .product(name: \"SwiftCrossUI\", package: \"swift-cross-ui\"),","        .product(name: \"DefaultBackend\", package: \"swift-cross-ui\"),","      ]","    )","    ...","  ]","  ...",")"],"type":"codeListing"},{"inlineContent":[{"text":"Figure 1: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"adding "},{"type":"codeVoice","code":"DefaultBackend"},{"type":"text","text":" to an executable target"}]}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCrossUI","import DefaultBackend","","@main","struct YourApp: App {","  \/\/ You can explicitly 