{"metadata":{"modules":[{"name":"SwiftCrossUI"}],"roleHeading":"Article","title":"DefaultBackend","role":"article"},"abstract":[{"type":"text","text":"An adaptive backend which uses different backends under the hood depending on the target operating system."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend"},"variants":[{"paths":["\/documentation\/swiftcrossui\/defaultbackend"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend"]}],"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The beauty of SwiftCrossUI is that you can write your app once and have it look native everywhere. For this reason I recommend using DefaultBackend unless you’ve got particular constraints. It uses ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","type":"reference","isActive":true},{"text":" on macOS, ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","type":"reference","isActive":true},{"text":" on Window, ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","type":"reference","isActive":true},{"text":" on Linux, and on ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","type":"reference","isActive":true},{"text":" on iOS\/tvOS.","type":"text"}]},{"name":"Tip","style":"tip","type":"aside","content":[{"inlineContent":[{"text":"If you’re using DefaultBackend, you can override the underlying backend during compilation by setting the ","type":"text"},{"code":"SCUI_DEFAULT_BACKEND","type":"codeVoice"},{"text":" environment variable to the name of the desired backend. This is useful when you e.g. want to test the Gtk version of your app while using a Mac. Note that this only works for built-in backends and still requires the chosen backend to be compatible with your machine.","type":"text"}],"type":"paragraph"}]},{"name":"Warning","style":"warning","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"When using ","type":"text"},{"code":"SCUI_DEFAULT_BACKEND","type":"codeVoice"},{"text":" to switch underlying backends, you may encounter some linker-related missing symbol errors. These are caused by a SwiftPM bug and usually disappear if you run ","type":"text"},{"code":"swift package clean","type":"codeVoice"},{"text":" before attempting to build your app again.","type":"text"}]}]},{"text":"Usage","type":"heading","level":2,"anchor":"Usage"},{"code":["...","","let package = Package(","  ...","  targets: [","    ...","    .executableTarget(","      name: \"YourApp\",","      dependencies: [","        .product(name: \"SwiftCrossUI\", package: \"swift-cross-ui\"),","        .product(name: \"DefaultBackend\", package: \"swift-cross-ui\"),","      ]","    )","    ...","  ]","  ...",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Figure 1: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"adding "},{"code":"DefaultBackend","type":"codeVoice"},{"type":"text","text":" to an executable target"}]}]},{"code":["import SwiftCrossUI","import DefaultBackend","","@main","struct YourApp: App {","  \/\/ You can explicitly initialize your app's chosen backend if you desire.","  \/\/ This happens automatically when you import any of the built-in backends.","  \/\/","  \/\/ var backend = DefaultBackend()","","  var body: some Scene {","    WindowGroup {","      Text(\"Hello, World!\")","        .padding()","    }","  }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 2: "},{"type":"emphasis","inlineContent":[{"text":"using ","type":"text"},{"code":"DefaultBackend","type":"codeVoice"}]}]}]}],"sections":[],"references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI/GtkBackend":{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","title":"GtkBackend","url":"\/documentation\/swiftcrossui\/gtkbackend","abstract":[{"type":"text","text":"SwiftCrossUI’s native Linux backend built on top of Gtk 4."}],"kind":"article","role":"article","type":"topic"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/UIKitBackend":{"kind":"article","url":"\/documentation\/swiftcrossui\/uikitbackend","title":"UIKitBackend","role":"article","type":"topic","abstract":[{"type":"text","text":"SwiftCrossUI’s native iOS and tvOS backend built on top of UIKit."}],"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Built-in-backends":{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends","url":"\/documentation\/swiftcrossui\/built-in-backends","role":"collectionGroup","title":"Built-in backends","kind":"article","abstract":[],"type":"topic"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/WinUIBackend":{"url":"\/documentation\/swiftcrossui\/winuibackend","title":"WinUIBackend","abstract":[{"type":"text","text":"SwiftCrossUI’s native Windows backend built on top of WinUI 3."}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI":{"title":"SwiftCrossUI","kind":"symbol","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","url":"\/documentation\/swiftcrossui","role":"collection","abstract":[{"text":"Create cross-platform desktop apps for macOS, Linux, Windows, iOS and tvOS.","type":"text"}],"type":"topic"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/AppKitBackend":{"url":"\/documentation\/swiftcrossui\/appkitbackend","kind":"article","type":"topic","title":"AppKitBackend","abstract":[{"type":"text","text":"SwiftCrossUI’s native macOS backend built on top of AppKit."}],"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","role":"article"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Gtk3Backend":{"abstract":[{"type":"text","text":"A secondary Linux backend built on top of Gtk 3 (for older distros without Gtk 4)."}],"title":"Gtk3Backend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend","kind":"article","role":"article","type":"topic","url":"\/documentation\/swiftcrossui\/gtk3backend"}}}