{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/swiftcrossui\/defaultbackend"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"An adaptive backend which uses different backends under the hood depending on the target operating system."}],"kind":"article","identifier":{"url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The beauty of SwiftCrossUI is that you can write your app once and have it look native everywhere. For this reason I recommend using DefaultBackend unless you’ve got particular constraints. It uses ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","isActive":true,"type":"reference"},{"text":" on macOS, ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","isActive":true,"type":"reference"},{"text":" on Window, ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","isActive":true,"type":"reference"},{"text":" on Linux, and on ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","isActive":true,"type":"reference"},{"text":" on iOS\/tvOS.","type":"text"}],"type":"paragraph"},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"If you’re using DefaultBackend, you can override the underlying backend during compilation by setting the ","type":"text"},{"code":"SCUI_DEFAULT_BACKEND","type":"codeVoice"},{"text":" environment variable to the name of the desired backend. This is useful when you e.g. want to test the Gtk version of your app while using a Mac. Note that this only works for built-in backends and still requires the chosen backend to be compatible with your machine.","type":"text"}]}]},{"name":"Warning","type":"aside","style":"warning","content":[{"inlineContent":[{"text":"When using ","type":"text"},{"code":"SCUI_DEFAULT_BACKEND","type":"codeVoice"},{"text":" to switch underlying backends, you may encounter some linker-related missing symbol errors. These are caused by a SwiftPM bug and usually disappear if you run ","type":"text"},{"code":"swift package clean","type":"codeVoice"},{"text":" before attempting to build your app again.","type":"text"}],"type":"paragraph"}]},{"level":2,"text":"Usage","type":"heading","anchor":"Usage"},{"syntax":"swift","code":["...","","let package = Package(","  ...","  targets: [","    ...","    .executableTarget(","      name: \"YourApp\",","      dependencies: [","        .product(name: \"SwiftCrossUI\", package: \"swift-cross-ui\"),","        .product(name: \"DefaultBackend\", package: \"swift-cross-ui\"),","      ]","    )","    ...","  ]","  ...",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Figure 1: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"adding "},{"type":"codeVoice","code":"DefaultBackend"},{"type":"text","text":" to an executable target"}]}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCrossUI","import DefaultBackend","","@main","struct YourApp: App {","  \/\/ You can explicitly initialize your app's chosen backend if you desire.","  \/\/ This happens automatically when you import any of the built-in backends.","  \/\/","  \/\/ var backend = DefaultBackend()","","  var body: some Scene {","    WindowGroup {","      Text(\"Hello, World!\")","        .padding()","    }","  }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Figure 2: ","type":"text"},{"inlineContent":[{"type":"text","text":"using "},{"code":"DefaultBackend","type":"codeVoice"}],"type":"emphasis"}],"type":"paragraph"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend"]}],"metadata":{"roleHeading":"Article","role":"article","title":"DefaultBackend","modules":[{"name":"SwiftCrossUI"}]},"references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI/GtkBackend":{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","role":"article","kind":"article","abstract":[{"text":"SwiftCrossUI’s native Linux backend built on top of Gtk 4.","type":"text"}],"title":"GtkBackend","type":"topic","url":"\/documentation\/swiftcrossui\/gtkbackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/WinUIBackend":{"role":"article","abstract":[{"text":"SwiftCrossUI’s native Windows backend built on top of WinUI 3.","type":"text"}],"url":"\/documentation\/swiftcrossui\/winuibackend","type":"topic","title":"WinUIBackend","kind":"article","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/UIKitBackend":{"role":"article","abstract":[{"text":"SwiftCrossUI’s native iOS and tvOS backend built on top of UIKit.","type":"text"}],"url":"\/documentation\/swiftcrossui\/uikitbackend","type":"topic","title":"UIKitBackend","kind":"article","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI":{"kind":"symbol","url":"\/documentation\/swiftcrossui","role":"collection","type":"topic","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","title":"SwiftCrossUI","abstract":[{"type":"text","text":"Create cross-platform desktop apps for macOS, Linux, Windows, iOS and tvOS."}]},"doc://SwiftCrossUI/documentation/SwiftCrossUI/AppKitBackend":{"type":"topic","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","abstract":[{"text":"SwiftCrossUI’s native macOS backend built on top of AppKit.","type":"text"}],"kind":"article","url":"\/documentation\/swiftcrossui\/appkitbackend","role":"article","title":"AppKitBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Built-in-backends":{"type":"topic","kind":"article","abstract":[],"title":"Built-in backends","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends","role":"collectionGroup","url":"\/documentation\/swiftcrossui\/built-in-backends"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Gtk3Backend":{"abstract":[{"text":"A secondary Linux backend built on top of Gtk 3 (for older distros without Gtk 4).","type":"text"}],"role":"article","type":"topic","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend","kind":"article","title":"Gtk3Backend","url":"\/documentation\/swiftcrossui\/gtk3backend"}}}