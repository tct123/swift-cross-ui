{"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The beauty of SwiftCrossUI is that you can write your app once and have it look native everywhere. For this reason I recommend using DefaultBackend unless you’ve got particular constraints. It uses "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","type":"reference","isActive":true},{"type":"text","text":" on macOS, "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","type":"reference","isActive":true},{"type":"text","text":" on Window, "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","type":"reference","isActive":true},{"type":"text","text":" on Linux, and on "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","type":"reference","isActive":true},{"type":"text","text":" on iOS\/tvOS."}]},{"type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"If you’re using DefaultBackend, you can override the underlying backend during compilation by setting the ","type":"text"},{"type":"codeVoice","code":"SCUI_DEFAULT_BACKEND"},{"text":" environment variable to the name of the desired backend. This is useful when you e.g. want to test the Gtk version of your app while using a Mac. Note that this only works for built-in backends and still requires the chosen backend to be compatible with your machine.","type":"text"}]}],"style":"tip"},{"type":"aside","name":"Warning","content":[{"inlineContent":[{"text":"When using ","type":"text"},{"type":"codeVoice","code":"SCUI_DEFAULT_BACKEND"},{"text":" to switch underlying backends, you may encounter some linker-related missing symbol errors. These are caused by a SwiftPM bug and usually disappear if you run ","type":"text"},{"type":"codeVoice","code":"swift package clean"},{"text":" before attempting to build your app again.","type":"text"}],"type":"paragraph"}],"style":"warning"},{"anchor":"Usage","type":"heading","level":2,"text":"Usage"},{"type":"codeListing","syntax":"swift","code":["...","","let package = Package(","  ...","  targets: [","    ...","    .executableTarget(","      name: \"YourApp\",","      dependencies: [","        .product(name: \"SwiftCrossUI\", package: \"swift-cross-ui\"),","        .product(name: \"DefaultBackend\", package: \"swift-cross-ui\"),","      ]","    )","    ...","  ]","  ...",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 1: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"adding "},{"type":"codeVoice","code":"DefaultBackend"},{"type":"text","text":" to an executable target"}]}]},{"type":"codeListing","syntax":"swift","code":["import SwiftCrossUI","import DefaultBackend","","@main","struct YourApp: App {","  \/\/ You can explicitly initialize your app's chosen backend if you desire.","  \/\/ This happens automatically when you import any of the built-in backends.","  \/\/","  \/\/ var backend = DefaultBackend()","","  var body: some Scene {","    WindowGroup {","      Text(\"Hello, World!\")","        .padding()","    }","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 2: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"using "},{"type":"codeVoice","code":"DefaultBackend"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcrossui\/defaultbackend"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend"]}],"sections":[],"abstract":[{"type":"text","text":"An adaptive backend which uses different backends under the hood depending on the target operating system."}],"metadata":{"title":"DefaultBackend","modules":[{"name":"SwiftCrossUI"}],"roleHeading":"Article","role":"article"},"kind":"article","references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI":{"kind":"symbol","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","role":"collection","title":"SwiftCrossUI","type":"topic","abstract":[{"type":"text","text":"Create cross-platform desktop apps for macOS, Linux, Windows, iOS and tvOS."}],"url":"\/documentation\/swiftcrossui"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/GtkBackend":{"type":"topic","kind":"article","abstract":[{"text":"SwiftCrossUI’s native Linux backend built on top of Gtk 4.","type":"text"}],"role":"article","url":"\/documentation\/swiftcrossui\/gtkbackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","title":"GtkBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Built-in-backends":{"url":"\/documentation\/swiftcrossui\/built-in-backends","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends","abstract":[],"kind":"article","type":"topic","title":"Built-in backends","role":"collectionGroup"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/WinUIBackend":{"type":"topic","kind":"article","abstract":[{"type":"text","text":"SwiftCrossUI’s native Windows backend built on top of WinUI 3."}],"role":"article","url":"\/documentation\/swiftcrossui\/winuibackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","title":"WinUIBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/UIKitBackend":{"type":"topic","kind":"article","abstract":[{"text":"SwiftCrossUI’s native iOS and tvOS backend built on top of UIKit.","type":"text"}],"role":"article","url":"\/documentation\/swiftcrossui\/uikitbackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","title":"UIKitBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Gtk3Backend":{"type":"topic","kind":"article","abstract":[{"type":"text","text":"A secondary Linux backend built on top of Gtk 3 (for older distros without Gtk 4)."}],"role":"article","url":"\/documentation\/swiftcrossui\/gtk3backend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend","title":"Gtk3Backend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/AppKitBackend":{"type":"topic","kind":"article","abstract":[{"text":"SwiftCrossUI’s native macOS backend built on top of AppKit.","type":"text"}],"role":"article","url":"\/documentation\/swiftcrossui\/appkitbackend","title":"AppKitBackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend"}}}