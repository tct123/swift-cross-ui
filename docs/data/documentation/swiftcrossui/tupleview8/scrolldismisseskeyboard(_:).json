{"abstract":[{"text":"Configures the behavior in which scrollable content interacts with","type":"text"},{"text":" ","type":"text"},{"text":"the software keyboard.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/TupleView8\/scrollDismissesKeyboard(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scrollDismissesKeyboard"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"mode"},{"kind":"text","text":": "},{"text":"ScrollDismissesKeyboardMode","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollDismissesKeyboardMode","kind":"typeIdentifier","preciseIdentifier":"s:12SwiftCrossUI27ScrollDismissesKeyboardModeO"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/View","kind":"typeIdentifier","preciseIdentifier":"s:12SwiftCrossUI4ViewP"},{"text":"\n","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"mode","content":[{"inlineContent":[{"text":"The keyboard dismissal mode that scrollable content","type":"text"},{"text":" ","type":"text"},{"text":"uses.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A view that uses the specified keyboard dismissal mode.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"You use this modifier to custom