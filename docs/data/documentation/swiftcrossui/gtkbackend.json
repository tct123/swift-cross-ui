{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcrossui\/gtkbackend"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"While Gtk isn’t the preferred UI framework on every Linux distro, it’s the closest thing SwiftCrossUI has to a native Linux backend for now. The Qt backend may be brought back to life at some point to cover the rest of Linux distros."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For targetting older pre Gtk 4 Linux distros, see the secondary "},{"type":"reference","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend","isActive":true}]},{"type":"paragraph","inlineContent":[{"text":"This backend supports Linux, macOS, and Windows, but its support for macOS has a few known issues worse due to underlying Gtk issues (and its support for Windows isn’t well tested).","type":"text"}]},{"level":2,"anchor":"System-dependencies","type":"heading","text":"System dependencies"},{"type":"paragraph","inlineContent":[{"text":"Before you can use ","type":"text"},{"code":"GtkBackend","type":"codeVoice"},{"text":" you must install the required system dependencies for your platform. Here are installation instructions tailored to each supported platform;","type":"text"}]},{"level":3,"anchor":"Linux","type":"heading","text":"Linux"},{"code":["# Debian-based distros","sudo apt install libgtk-4-dev clang","","# Fedora-based distros","sudo dnf install gtk4-devel clang"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"Figure 1: ","type":"text"},{"inlineContent":[{"type":"text","text":"installing the required dependencies on Debian-based and Fedora-based Linux distros"}],"type":"emphasis"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you run into errors related to not finding "},{"type":"codeVoice","code":"gtk\/gtk.h"},{"type":"text","text":" when trying to build a swift-cross-ui project, try restarting your computer. This has worked in some cases (although there may be a more elegant solution)."}]},{"type":"paragraph","inlineContent":[{"text":"If you are on a non-Debian non-Fedora distro and the ","type":"text"},{"code":"GtkBackend","type":"codeVoice"},{"text":" requirements end up differing significantly from the requirements stated above, please open a GitHub issue or PR so that we can improve the documentation.","type":"text"}]},{"level":3,"anchor":"macOS","type":"heading","text":"macOS"},{"code":["brew install pkg-config gtk4"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 2: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"installing the required dependencies using Homebrew"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t have Homebrew, installation instructions can be found at "},{"type":"reference","identifier":"https:\/\/brew.sh","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It should also be possible to use "},{"type":"codeVoice","code":"gtk4"},{"type":"text","text":" installed via MacPorts, but I have not tested that."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you run into errors related to "},{"type":"codeVoice","code":"libffi"},{"type":"text","text":" or "},{"type":"codeVoice","code":"FFI"},{"type":"text","text":" when trying to build a swift-cross-ui project with "},{"type":"codeVoice","code":"GtkBackend"},{"type":"text","text":", which can occur when certain older versions of the Xcode Command Line Tools are installed, try running the following command to patch libffi:"}]},{"code":["sed -i '' 's\/-I..includedir.\/\/g' $(brew --prefix)\/Library\/Homebrew\/os\/mac\/pkgconfig\/*\/libffi.pc"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"Figure 3: ","type":"text"},{"inlineContent":[{"type":"text","text":"fixing the "},{"type":"codeVoice","code":"libffi"},{"type":"text","text":" issue that some people face"}],"type":"emphasis"}]},{"level":3,"anchor":"Windows","type":"heading","text":"Windows"},{"type":"paragraph","inlineContent":[{"text":"On Windows things are a bit complicated (as usual), so we only support installation via ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/microsoft\/vcpkg","type":"reference"},{"text":". First, install vcpkg;","type":"text"}]},{"code":["git clone https:\/\/github.com\/microsoft\/vcpkg C:\\vcpkg","C:\\vcpkg\\bootstrap-vcpkg.bat"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 4: "},{"inlineContent":[{"type":"text","text":"install vcpkg (requires git cli)"}],"type":"emphasis"}]},{"style":"warning","type":"aside","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"It’s important to install vcpkg at the root of a drive due to limitations of the Gtk build system."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"After installation, make the following changes to your environment variables:","type":"text"}],"type":"strong"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Set the ","type":"text"},{"code":"PKG_CONFIG_PATH","type":"codeVoice"},{"text":" environment variable to ","type":"text"},{"code":"C:\\vcpkg\\installed\\x64-windows\\lib\\pkgconfig","type":"codeVoice"},{"text":". This is only required for building.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"code":"C:\\vcpkg\\installed\\x64-windows\\bin","type":"codeVoice"},{"type":"text","text":" to your "},{"code":"Path","type":"codeVoice"},{"type":"text","text":" environment variable. This is only required for running."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"With vcpkg installed, you have two options for Gtk installation; global installation, and project-local installation","type":"text"}]},{"level":4,"anchor":"Global-Gtk-4-installation-recommended","type":"heading","text":"Global Gtk 4 installation (recommended)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the command depends on your machine’s architecture; choose between Figure 5 and Figure 6 accordingly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Installation can take 45+ minutes depending on your machine."}]},{"code":["C:\\vcpkg\\vcpkg.exe install gtk --triplet x64-windows"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"Figure 5: ","type":"text"},{"inlineContent":[{"text":"install Gtk 4 globally on x64 Windows","type":"text"}],"type":"emphasis"}]},{"code":["C:\\vcpkg\\vcpkg.exe install gtk --triplet arm64-windows"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"Figure 6: ","type":"text"},{"inlineContent":[{"text":"install Gtk 4 globally on arm64 Windows","type":"text"}],"type":"emphasis"}]},{"style":"warning","type":"aside","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"Run the chosen command at the root of your drive to ensure that vcpkg doesn’t run in manifest mode."}],"type":"paragraph"}]},{"level":4,"anchor":"Project-local-Gtk-4-installation-more-unreliable","type":"heading","text":"Project-local Gtk 4 installation (more unreliable)"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"If the absolute path to your project contains spaces, it is possible that vcpkg will break, and installing globally will be a more reliable strategy.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"To install Gtk 4 in a project-local dependency store you must setup a ","type":"text"},{"code":"vcpkg.json","type":"codeVoice"},{"text":" manifest file and then run vcpkg, as detailed below;","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"First ","type":"text"},{"code":"vcpkg.json","type":"codeVoice"},{"text":" at the root of your project and make sure that it includes the ","type":"text"},{"code":"gtk","type":"codeVoice"},{"text":" dependency as demonstrated in Figure 7.","type":"text"}]},{"code":["{","    \"name\": \"project-name\",","    \"version-string\": \"main\",","    \"dependencies\": [\"gtk\"]","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 7: "},{"inlineContent":[{"type":"text","text":"an example "},{"code":"vcpkg.json","type":"codeVoice"},{"type":"text","text":" package manifest"}],"type":"emphasis"}]},{"code":["C:\\vcpkg\\vcpkg.exe install --triplet x64-windows"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 8: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"install the dependencies listed in your package manifest"}]}]},{"style":"warning","type":"aside","name":"Warning","content":[{"inlineContent":[{"type":"text","text":"Replace the triplet with "},{"code":"arm64-windows","type":"codeVoice"},{"type":"text","text":" if you’re on ARM64"}],"type":"paragraph"}]},{"level":2,"anchor":"Usage","type":"heading","text":"Usage"},{"code":["...","","let package = Package(","  ...","  targets: [","    ...","    .executableTarget(","      name: \"YourApp\",","      dependencies: [","        .product(name: \"SwiftCrossUI\", package: \"swift-cross-ui\"),","        .product(name: \"GtkBackend\", package: \"swift-cross-ui\"),","      ]","    )","    ...","  ]","  ...",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Figure 9: ","type":"text"},{"inlineContent":[{"type":"text","text":"adding "},{"type":"codeVoice","code":"GtkBackend"},{"type":"text","text":" to an executable target"}],"type":"emphasis"}]},{"code":["import SwiftCrossUI","import GtkBackend","","@main","struct YourApp: App {","  \/\/ You can explicitly initialize your app's chosen backend if you desire.","  \/\/ This happens automatically when you import any of the built-in backends.","  \/\/","  \/\/ var backend = GtkBackend()","  \/\/","  \/\/ If you aren't using Swift Bundler, you may have to explicitly provide","  \/\/ your app's identifier for some GtkBackend features to work correctly","  \/\/ (such as handling custom URL schemes).","  \/\/","  \/\/ var backend = GtkBackend(appIdentifier: \"com.example.YourApp\")","","  var body: some Scene {","    WindowGroup {","      Text(\"Hello, World!\")","        .padding()","    }","  }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 10: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"using "},{"code":"GtkBackend","type":"codeVoice"}]}]}]}],"abstract":[{"type":"text","text":"SwiftCrossUI’s native Linux backend built on top of Gtk 4."}],"metadata":{"roleHeading":"Article","title":"GtkBackend","modules":[{"name":"SwiftCrossUI"}],"role":"article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend"],"generated":true}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends"]]},"references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI/UIKitBackend":{"type":"topic","kind":"article","abstract":[{"text":"SwiftCrossUI’s native iOS and tvOS backend built on top of UIKit.","type":"text"}],"role":"article","url":"\/documentation\/swiftcrossui\/uikitbackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","title":"UIKitBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/DefaultBackend":{"type":"topic","kind":"article","abstract":[{"text":"An adaptive backend which uses different backends under the hood depending on the target operating system.","type":"text"}],"role":"article","url":"\/documentation\/swiftcrossui\/defaultbackend","title":"DefaultBackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend"},"https://brew.sh":{"url":"https:\/\/brew.sh","titleInlineContent":[{"type":"text","text":"brew.sh"}],"title":"brew.sh","type":"link","identifier":"https:\/\/brew.sh"},"doc://SwiftCrossUI/documentation/SwiftCrossUI":{"kind":"symbol","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","role":"collection","title":"SwiftCrossUI","type":"topic","abstract":[{"type":"text","text":"Create cross-platform desktop apps for macOS, Linux, Windows, iOS and tvOS."}],"url":"\/documentation\/swiftcrossui"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/WinUIBackend":{"type":"topic","kind":"article","abstract":[{"type":"text","text":"SwiftCrossUI’s native Windows backend built on top of WinUI 3."}],"role":"article","url":"\/documentation\/swiftcrossui\/winuibackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","title":"WinUIBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/AppKitBackend":{"type":"topic","kind":"article","abstract":[{"text":"SwiftCrossUI’s native macOS backend built on top of AppKit.","type":"text"}],"role":"article","url":"\/documentation\/swiftcrossui\/appkitbackend","title":"AppKitBackend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend"},"https://github.com/microsoft/vcpkg":{"url":"https:\/\/github.com\/microsoft\/vcpkg","titleInlineContent":[{"type":"text","text":"vcpkg"}],"title":"vcpkg","type":"link","identifier":"https:\/\/github.com\/microsoft\/vcpkg"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Gtk3Backend":{"type":"topic","kind":"article","abstract":[{"type":"text","text":"A secondary Linux backend built on top of Gtk 3 (for older distros without Gtk 4)."}],"role":"article","url":"\/documentation\/swiftcrossui\/gtk3backend","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend","title":"Gtk3Backend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Built-in-backends":{"url":"\/documentation\/swiftcrossui\/built-in-backends","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends","abstract":[],"kind":"article","type":"topic","title":"Built-in backends","role":"collectionGroup"}}}