{"identifier":{"url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/GtkBackend","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftCrossUI"}],"role":"article","title":"GtkBackend"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"While Gtk isn’t the preferred UI framework on every Linux distro, it’s the closest thing SwiftCrossUI has to a native Linux backend for now. The Qt backend may be brought back to life at some point to cover the rest of Linux distros.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For targetting older pre Gtk 4 Linux distros, see the secondary "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend"}]},{"type":"paragraph","inlineContent":[{"text":"This backend supports Linux, macOS, and Windows, but its support for macOS has a few known issues worse due to underlying Gtk issues (and its support for Windows isn’t well tested).","type":"text"}]},{"type":"heading","anchor":"System-dependencies","text":"System dependencies","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before you can use "},{"type":"codeVoice","code":"GtkBackend"},{"type":"text","text":" you must install the required system dependencies for your platform. Here are installation instructions tailored to each supported platform;"}]},{"type":"heading","anchor":"Linux","text":"Linux","level":3},{"type":"codeListing","code":["# Debian-based distros","sudo apt install libgtk-4-dev clang","","# Fedora-based distros","sudo dnf install gtk4-devel clang"],"syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 1: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"installing the required dependencies on Debian-based and Fedora-based Linux distros"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you run into errors related to not finding "},{"code":"gtk\/gtk.h","type":"codeVoice"},{"type":"text","text":" when trying to build a swift-cross-ui project, try restarting your computer. This has worked in some cases (although there may be a more elegant solution)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are on a non-Debian non-Fedora distro and the "},{"type":"codeVoice","code":"GtkBackend"},{"type":"text","text":" requirements end up differing significantly from the requirements stated above, please open a GitHub issue or PR so that we can improve the documentation."}]},{"type":"heading","level":3,"text":"macOS","anchor":"macOS"},{"code":["brew install pkg-config gtk4"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 2: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"installing the required dependencies using Homebrew"}]}]},{"type":"paragraph","inlineContent":[{"text":"If you don’t have Homebrew, installation instructions can be found at ","type":"text"},{"isActive":true,"identifier":"https:\/\/brew.sh","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It should also be possible to use "},{"type":"codeVoice","code":"gtk4"},{"type":"text","text":" installed via MacPorts, but I have not tested that."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you run into errors related to "},{"type":"codeVoice","code":"libffi"},{"type":"text","text":" or "},{"type":"codeVoice","code":"FFI"},{"type":"text","text":" when trying to build a swift-cross-ui project with "},{"type":"codeVoice","code":"GtkBackend"},{"type":"text","text":", which can occur when certain older versions of the Xcode Command Line Tools are installed, try running the following command to patch libffi:"}]},{"code":["sed -i '' 's\/-I..includedir.\/\/g' $(brew --prefix)\/Library\/Homebrew\/os\/mac\/pkgconfig\/*\/libffi.pc"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 3: "},{"type":"emphasis","inlineContent":[{"text":"fixing the ","type":"text"},{"code":"libffi","type":"codeVoice"},{"text":" issue that some people face","type":"text"}]}]},{"type":"heading","level":3,"text":"Windows","anchor":"Windows"},{"type":"paragraph","inlineContent":[{"text":"On Windows things are a bit complicated (as usual), so we only support installation via ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/microsoft\/vcpkg","type":"reference"},{"text":". First, install vcpkg;","type":"text"}]},{"type":"codeListing","code":["git clone https:\/\/github.com\/microsoft\/vcpkg C:\\vcpkg","C:\\vcpkg\\bootstrap-vcpkg.bat"],"syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"Figure 4: ","type":"text"},{"inlineContent":[{"type":"text","text":"install vcpkg (requires git cli)"}],"type":"emphasis"}]},{"type":"aside","style":"warning","content":[{"inlineContent":[{"text":"It’s important to install vcpkg at the root of a drive due to limitations of the Gtk build system.","type":"text"}],"type":"paragraph"}],"name":"Warning"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"After installation, make the following changes to your environment variables:","type":"text"}]}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the "},{"code":"PKG_CONFIG_PATH","type":"codeVoice"},{"type":"text","text":" environment variable to "},{"code":"C:\\vcpkg\\installed\\x64-windows\\lib\\pkgconfig","type":"codeVoice"},{"type":"text","text":". This is only required for building."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"C:\\vcpkg\\installed\\x64-windows\\bin"},{"type":"text","text":" to your "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" environment variable. This is only required for running."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With vcpkg installed, you have two options for Gtk installation; global installation, and project-local installation"}]},{"type":"heading","anchor":"Global-Gtk-4-installation-recommended","level":4,"text":"Global Gtk 4 installation (recommended)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the command depends on your machine’s architecture; choose between Figure 5 and Figure 6 accordingly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Installation can take 45+ minutes depending on your machine."}]},{"type":"codeListing","code":["C:\\vcpkg\\vcpkg.exe install gtk --triplet x64-windows"],"syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 5: "},{"inlineContent":[{"type":"text","text":"install Gtk 4 globally on x64 Windows"}],"type":"emphasis"}]},{"type":"codeListing","code":["C:\\vcpkg\\vcpkg.exe install gtk --triplet arm64-windows"],"syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Figure 6: "},{"inlineContent":[{"type":"text","text":"install Gtk 4 globally on arm64 Windows"}],"type":"emphasis"}]},{"type":"aside","style":"warning","content":[{"inlineContent":[{"type":"text","text":"Run the chosen command at the root of your drive to ensure that vcpkg doesn’t run in manifest mode."}],"type":"paragraph"}],"name":"Warning"},{"type":"heading","anchor":"Project-local-Gtk-4-installation-more-unreliable","level":4,"text":"Project-local Gtk 4 installation (more unreliable)"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"If the absolute path to your project contains spaces, it is possible that vcpkg will break, and installing globally will be a more reliable strategy.","type":"text"}]}],"name":"Note"},{"type":"paragraph","inlineContent":[{"text":"To install Gtk 4 in a project-local dependency store you must setup a ","type":"text"},{"code":"vcpkg.json","type":"codeVoice"},{"text":" manifest file and then run vcpkg, as detailed below;","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"First ","type":"text"},{"code":"vcpkg.json","type":"codeVoice"},{"text":" at the root of your project and make sure that it includes the ","type":"text"},{"code":"gtk","type":"codeVoice"},{"text":" dependency as demonstrated in Figure 7.","type":"text"}]},{"type":"codeListing","code":["{","    \"name\": \"project-name\",","    \"version-string\": \"main\",","    \"dependencies\": [\"gtk\"]","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Figure 7: ","type":"text"},{"inlineContent":[{"type":"text","text":"an example "},{"type":"codeVoice","code":"vcpkg.json"},{"type":"text","text":" package manifest"}],"type":"emphasis"}]},{"type":"codeListing","code":["C:\\vcpkg\\vcpkg.exe install --triplet x64-windows"],"syntax":"sh"},{"type":"paragraph","inlineContent":[{"text":"Figure 8: ","type":"text"},{"inlineContent":[{"text":"install the dependencies listed in your package manifest","type":"text"}],"type":"emphasis"}]},{"type":"aside","style":"warning","content":[{"inlineContent":[{"text":"Replace the triplet with ","type":"text"},{"type":"codeVoice","code":"arm64-windows"},{"text":" if you’re on ARM64","type":"text"}],"type":"paragraph"}],"name":"Warning"},{"type":"heading","anchor":"Usage","level":2,"text":"Usage"},{"type":"codeListing","code":["...","","let package = Package(","  ...","  targets: [","    ...","    .executableTarget(","      name: \"YourApp\",","      dependencies: [","        .product(name: \"SwiftCrossUI\", package: \"swift-cross-ui\"),","        .product(name: \"GtkBackend\", package: \"swift-cross-ui\"),","      ]","    )","    ...","  ]","  ...",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Figure 9: ","type":"text"},{"inlineContent":[{"type":"text","text":"adding "},{"code":"GtkBackend","type":"codeVoice"},{"type":"text","text":" to an executable target"}],"type":"emphasis"}]},{"type":"codeListing","code":["import SwiftCrossUI","import GtkBackend","","@main","struct YourApp: App {","  \/\/ You can explicitly initialize your app's chosen backend if you desire.","  \/\/ This happens automatically when you import any of the built-in backends.","  \/\/","  \/\/ var backend = GtkBackend()","  \/\/","  \/\/ If you aren't using Swift Bundler, you may have to explicitly provide","  \/\/ your app's identifier for some GtkBackend features to work correctly","  \/\/ (such as handling custom URL schemes).","  \/\/","  \/\/ var backend = GtkBackend(appIdentifier: \"com.example.YourApp\")","","  var body: some Scene {","    WindowGroup {","      Text(\"Hello, World!\")","        .padding()","    }","  }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Figure 10: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"using "},{"type":"codeVoice","code":"GtkBackend"}]}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"text":"SwiftCrossUI’s native Linux backend built on top of Gtk 4.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftcrossui\/gtkbackend"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend"],"generated":true}],"references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI/WinUIBackend":{"abstract":[{"type":"text","text":"SwiftCrossUI’s native Windows backend built on top of WinUI 3."}],"title":"WinUIBackend","role":"article","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WinUIBackend","type":"topic","kind":"article","url":"\/documentation\/swiftcrossui\/winuibackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/AppKitBackend":{"abstract":[{"type":"text","text":"SwiftCrossUI’s native macOS backend built on top of AppKit."}],"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/AppKitBackend","type":"topic","url":"\/documentation\/swiftcrossui\/appkitbackend","kind":"article","title":"AppKitBackend","role":"article"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/DefaultBackend":{"kind":"article","url":"\/documentation\/swiftcrossui\/defaultbackend","role":"article","title":"DefaultBackend","abstract":[{"text":"An adaptive backend which uses different backends under the hood depending on the target operating system.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Gtk3Backend":{"abstract":[{"type":"text","text":"A secondary Linux backend built on top of Gtk 3 (for older distros without Gtk 4)."}],"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Gtk3Backend","type":"topic","url":"\/documentation\/swiftcrossui\/gtk3backend","kind":"article","title":"Gtk3Backend","role":"article"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/UIKitBackend":{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend","kind":"article","type":"topic","role":"article","abstract":[{"text":"SwiftCrossUI’s native iOS and tvOS backend built on top of UIKit.","type":"text"}],"url":"\/documentation\/swiftcrossui\/uikitbackend","title":"UIKitBackend"},"https://github.com/microsoft/vcpkg":{"type":"link","url":"https:\/\/github.com\/microsoft\/vcpkg","identifier":"https:\/\/github.com\/microsoft\/vcpkg","title":"vcpkg","titleInlineContent":[{"type":"text","text":"vcpkg"}]},"doc://SwiftCrossUI/documentation/SwiftCrossUI/Built-in-backends":{"url":"\/documentation\/swiftcrossui\/built-in-backends","type":"topic","title":"Built-in backends","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/Built-in-backends","role":"collectionGroup","abstract":[],"kind":"article"},"https://brew.sh":{"identifier":"https:\/\/brew.sh","title":"brew.sh","type":"link","url":"https:\/\/brew.sh","titleInlineContent":[{"text":"brew.sh","type":"text"}]},"doc://SwiftCrossUI/documentation/SwiftCrossUI":{"url":"\/documentation\/swiftcrossui","type":"topic","kind":"symbol","title":"SwiftCrossUI","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","role":"collection","abstract":[{"text":"Create cross-platform desktop apps for macOS, Linux, Windows, iOS and tvOS.","type":"text"}]}}}