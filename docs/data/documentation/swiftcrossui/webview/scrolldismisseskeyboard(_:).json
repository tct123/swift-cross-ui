xt":" "},{"type":"text","text":"dismissing automatically. Note that "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/TextEditor"},{"type":"text","text":" may still use a different"},{"type":"text","text":" "},{"type":"text","text":"default to preserve expected editing behavior."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WebView\/scrollDismissesKeyboard(_:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcrossui\/webview\/scrolldismisseskeyboard(_:)"]}],"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/WebView"]]},"metadata":{"externalID":"s:12SwiftCrossUI4ViewPAAE23scrollDismissesKeyboardyQrAA06ScrollfG4ModeOF::SYNTHESIZED::s:12SwiftCrossUI7WebViewV","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"SwiftCrossUI"}],"extendedModule":"SwiftCrossUI","remoteSource":{"url":"https:\/\/github.com\/stackotter\/swift-cross-ui\/blob\/main\/Sources\/SwiftCrossUI\/Views\/Modifiers\/ScrollDismissesKeyboardModifier.swift#L36","fileName":"ScrollDismissesKeyboardModifier.swift"},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scrollDismissesKeyboard"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:12SwiftCrossUI27ScrollDismissesKeyboardModeO","text":"ScrollDismissesKeyboardMode"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:12SwiftCrossUI4ViewP","text":"View"}],"role":"symbol","title":"scrollDismissesKeyboard(_:)"},"references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI/TextEditor":{"role":"symbol","navigatorTitle":[{"text":"TextEditor","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A c