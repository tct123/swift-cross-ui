{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollView"]]},"identifier":{"url":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollView\/scrollDismissesKeyboard(_:)","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scrollDismissesKeyboard"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"mode"},{"kind":"text","text":": "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollDismissesKeyboardMode","preciseIdentifier":"s:12SwiftCrossUI27ScrollDismissesKeyboardModeO","text":"ScrollDismissesKeyboardMode","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/View","preciseIdentifier":"s:12SwiftCrossUI4ViewP","text":"View","kind":"typeIdentifier"},{"text":"\n","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The keyboard dismissal mode that scrollable content","type":"text"},{"text":" ","type":"text"},{"text":"uses.","type":"text"}],"type":"paragraph"}],"name":"mode"}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A view that uses the specified keyboard dismissal mode.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"You use this modifier to customize how scrollable content interacts","type":"text"},{"text":" ","type":"text"},{"text":"with the software keyboard. For example, you can specify a value of","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollDismissesKeyboardMode\/immediately","isActive":true,"type":"reference"},{"text":" to indicate that you","type":"text"},{"text":" ","type":"text"},{"text":"would like scrollable content to immediately dismiss the keyboard if","type":"text"},{"text":" ","type":"text"},{"text":"present when a scroll drag gesture begins.","type":"text"}]},{"type":"codeListing","code":["@State private var text = \"\"","","ScrollView {","    TextField(\"Prompt\", text: $text)","    ForEach(0 ..< 50) { index in","        Text(\"\\(index)\")","            .padding()","    }","}",".scrollDismissesKeyboard(.immediately)"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use this modifier to customize the keyboard dismissal"},{"type":"text","text":" "},{"type":"text","text":"behavior for other kinds of scrollable views, like a "},{"type":"reference","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/List","isActive":true},{"type":"text","text":" or a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/TextEditor","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, scrollable content dismisses the keyboard interactively as the user scrolls."},{"type":"text","text":" "},{"type":"text","text":"Pass a different value of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollDismissesKeyboardMode"},{"type":"text","text":" to change this behavior."},{"type":"text","text":" "},{"type":"text","text":"For example, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftCrossU