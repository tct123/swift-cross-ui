codeListing","syntax":"sh","code":["swift bundler create HelloWorld --template SwiftCrossUI","cd HelloWorld"]},{"type":"heading","text":"Running your app","level":2,"anchor":"Running-your-app"},{"type":"paragraph","inlineContent":[{"text":"Running your new app with Swift Bundler is as simple as it gets!","type":"text"}]},{"type":"codeListing","syntax":"sh","code":["swift bundler run"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS you can provide the "},{"type":"codeVoice","code":"--device <device_name_or_id>"},{"type":"text","text":" option to run the app on a connected iOS or tvOS device, or the "},{"type":"codeVoice","code":"--simulator <simulator_name_or_id>"},{"type":"text","text":" option to run the app in a simulator."}]},{"type":"codeListing","syntax":"sh","code":["# You can use any substring of the target device name. For example,","# \"iPhone\" matches any device connected with \"iPhone\" in its name.","swift bundler run --device \"iPhone\"","swift bundler run --simulator \"iPhone 15\""]},{"type":"heading","text":"Making a change","level":2,"anchor":"Making-a-change"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"code":"Sources\/HelloWorld\/HelloWorldApp.swift","type":"codeVoice"},{"type":"text","text":" in an editor of your choosing. Change "},{"code":"\"Hello, World!\"","type":"codeVoice"},{"type":"text","text":" to "},{"code":"\"Hello, Earth!\"","type":"codeVoice"},{"type":"text","text":". Repeat the previous step to verify that your changes get reflected."}]},{"type":"heading","text":"All done","level":2,"anchor":"All-done"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You’re good to go! If you make something cool with SwiftCrossUI let us know so we can add your project to our showcase once the SwiftCrossUI website is up and running!"}]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcrossui\/quick-start"]}],"schemaVers