pe":"text","text":"SwiftCrossUI’s native iOS and tvOS backend built on top of UIKit."}],"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/UIKitBackend"},"doc://SwiftCrossUI/documentation/SwiftCrossUI":{"title":"SwiftCrossUI","kind":"symbol","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","url":"\/documentation\/swiftcrossui","role":"collection","abstract":[{"text":"Create cross-platform desktop apps for macOS, Linux, Windows, iOS and tvOS.","type":"text"}],"type":"topic"},"doc://SwiftCrossUI/documentation/SwiftCrossUI/DefaultBackend":{"abstract":[{"type":"text","text":"An adaptive backend which uses different backends under the hood depending on the target operating system."}],"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/DefaultBackend","type":"topic","kind":"article","title":"DefaultBackend","role":"article","url":"\/documentation\/swiftcrossui\/defaultbackend"},"https://brew.sh":{"titleInlineContent":[{"type":"text","text":"brew.sh"}],"identifier":"https:\/\/brew.sh","type":"link","title":"brew.sh","url":"https:\/\/brew.sh"}}}