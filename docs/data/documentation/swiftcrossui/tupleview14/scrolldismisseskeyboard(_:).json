o use this modifier to customize the keyboard dismissal"},{"type":"text","text":" "},{"type":"text","text":"behavior for other kinds of scrollable views, like a "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/List","type":"reference","isActive":true},{"type":"text","text":" or a"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/TextEditor","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"By default, scrollable content dismisses the keyboard interactively as the user scrolls."},{"type":"text","text":" "},{"type":"text","text":"Pass a different value of "},{"type":"reference","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollDismissesKeyboardMode","isActive":true},{"type":"text","text":" to change this behavior."},{"type":"text","text":" "},{"type":"text","text":"For example, use "},{"type":"reference","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/ScrollDismissesKeyboardMode\/never","isActive":true},{"type":"text","text":" to prevent the keyboard from"},{"type":"text","text":" "},{"type":"text","text":"dismissing automatically. Note that "},{"type":"reference","identifier":"doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/TextEditor","isActive":true},{"type":"text","text":" may still use a different"},{"type":"text","text":" "},{"type":"text","text":"default to preserve expected editing behavior."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcrossui\/tupleview14\/scrolldismisseskeyboard(_:)"]}],"hierarchy":{"paths":[["doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI","doc:\/\/SwiftCrossUI\/documentation\/SwiftCrossUI\/TupleView14"]]},"references":{"doc://SwiftCrossUI/documentation/SwiftCrossUI/TupleView14":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","te